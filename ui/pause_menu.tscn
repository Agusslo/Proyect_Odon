[gd_scene format=3]

[ext_resource type="Script" path="res://ui/pause_menu.gd" id="1_pause"]
[ext_resource type="Script" path="res://ui/menu_button.gd" id="2_btn"]
[ext_resource type="FontFile" path="res://assets/fonts/Cinzel.ttf" id="3_cinzel"]
[ext_resource type="FontFile" path="res://assets/fonts/Rajdhani-Medium.ttf" id="4_rajdhani"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_btn"]

[node name="PauseMenu" type="CanvasLayer"]
layer = 20
script = ExtResource("1_pause")

[node name="Root" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.05, 0.75)

[node name="Box" type="VBoxContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -80.0
offset_top = -50.0
offset_right = 80.0
offset_bottom = 50.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6

[node name="Label" type="Label" parent="Root/Box"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_cinzel")
theme_override_font_sizes/font_size = 20
text = "Pausa"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Root/Box"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_rajdhani")
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBoxEmpty_btn")
theme_override_styles/focus = SubResource("StyleBoxEmpty_btn")
theme_override_styles/hover = SubResource("StyleBoxEmpty_btn")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_btn")
text = "Continuar"
script = ExtResource("2_btn")

[node name="Title" type="Button" parent="Root/Box"]
layout_mode = 2
theme_override_fonts/font = ExtResource("4_rajdhani")
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBoxEmpty_btn")
theme_override_styles/focus = SubResource("StyleBoxEmpty_btn")
theme_override_styles/hover = SubResource("StyleBoxEmpty_btn")
theme_override_styles/pressed = SubResource("StyleBoxEmpty_btn")
text = "Volver al título"
script = ExtResource("2_btn")
