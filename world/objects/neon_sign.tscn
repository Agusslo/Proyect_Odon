[gd_scene format=3]

[ext_resource type="Script" path="res://world/objects/neon_sign.gd" id="1_sign"]
[ext_resource type="Texture2D" path="res://assets/props/glow.png" id="2_glow"]
[ext_resource type="Texture2D" path="res://assets/props/sign_red.png" id="3_tex"]
[ext_resource type="Script" path="res://components/neon_flicker_component.gd" id="4_flicker"]

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_add"]
blend_mode = 1

[node name="NeonSign" type="Node2D"]
script = ExtResource("1_sign")
sign_texture = ExtResource("3_tex")

[node name="Glow" type="Sprite2D" parent="."]
material = SubResource("CanvasItemMaterial_add")
texture = ExtResource("2_glow")

[node name="Sign" type="Sprite2D" parent="."]
texture = ExtResource("3_tex")

[node name="NeonFlickerComponent" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("4_flicker")
target = NodePath("..")
